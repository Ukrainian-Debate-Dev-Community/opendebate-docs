          "t": "GET /announcements",
          "method": "GET",
          "path": "/announcements",
          "desc": "member, those for them"
        },
        {
          "id": "api-ann-post",
          "t": "POST /announcements",
          "method": "POST",
          "path": "/announcements",
          "desc": "board, {title, text, for}"
        },
        {
          "id": "api-members",
          "t": "GET /members",
          "method": "GET",
          "path": "/members",
          "desc": "member, names, branches, status; contacts for the branch head and secretariat"
        },
        {
          "id": "api-branches",
          "t": "GET /branches",
          "method": "GET",
          "path": "/branches",
          "desc": "member, branches and heads"
        },
        {
          "id": "api-leadership",
          "t": "GET /leadership",
          "method": "GET",
          "path": "/leadership",
          "desc": "member, the leadership and the supervisory board"
        },
        {
          "id": "api-adj",
          "t": "GET /adjudicators",
          "method": "GET",
          "path": "/adjudicators",
          "desc": "member, the AKS register"
        }
      ]
    },
    {
      "title": "roles",
      "rows": [
        {
          "id": "api-roles",
          "t": "GET /people",
          "method": "GET",
          "path": "/people",
          "desc": "secretariat, everyone with a dfu role"
        },
        {
          "id": "api-roles-post",
          "t": "POST /people",
          "method": "POST",
          "path": "/people",
          "desc": "secretariat, {account, role, branch, scopes}",
