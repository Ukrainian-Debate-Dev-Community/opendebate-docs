          "path": "/api/documents?public=1",
          "desc": "the public documents only"
        },
        {
          "id": "api-structure",
          "t": "GET /api/structure",
          "method": "GET",
          "path": "/api/structure",
          "desc": "leadership, supervisory board and branches, for About"
        }
      ]
