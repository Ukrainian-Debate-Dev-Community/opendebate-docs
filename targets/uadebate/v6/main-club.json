      "html": "<div class=\"ua\"><header class=\"ua-top\"><a class=\"ua-brand wordmark\" href=\"#\">UAdebates</a><nav class=\"ua-nav\"><a href=\"#\">Home</a><a href=\"#\">News</a><a href=\"#\">Calendar</a><a class=\"on\" href=\"#\">Clubs</a><a href=\"#\">About</a></nav><div class=\"ua-right\"><span class=\"ua-lang\"><b>EN</b> | <a href=\"#\">UA</a></span><a class=\"ua-btn ua-btn--line ua-btn--sm\" href=\"#\">Cabinet</a></div></header><main class=\"ua-main\"><div class=\"ua-crumbs\"><a href=\"#\">Clubs</a> / Kyiv</div><div class=\"ua-head\"><div><span class=\"ua-kicker\">Kyiv</span><h1>Kyiv Debate Club</h1><p class=\"ua-lead\">Weekly British Parliamentary practice for students and graduates.</p></div><div class=\"ua-head-act\"><a class=\"ua-btn ua-btn--gold\" href=\"#\">Open in cab</a><a class=\"ua-btn ua-btn--line\" href=\"#\">Contact the club</a></div></div><div class=\"ua-tags\"><span class=\"ua-tag ua-tag--info\">BP</span><span class=\"ua-tag ua-tag--info\">Ukrainian</span><span class=\"ua-tag ua-tag--info\">English</span><span class=\"ua-tag ua-tag--info\">university students</span></div><div class=\"ua-grid2\"><div><div class=\"ua-sec\">About the club</div><div class=\"ua-card ua-pad ua-dl\"><div><span>Meets</span>Thursday 18:30, 4 Hrushevskoho St</div><div><span>Members</span>11</div><div><span>Head</span>Oleksii Stroganov</div><div><span>Contact</span><a href=\"#\">t.me/kyivdc</a></div></div><div class=\"ua-sec\">Upcoming club sessions</div><div class=\"ua-ev\"><span class=\"ua-date\"><b>16</b><span>Oct</span></span><div class=\"ua-ev-body\"><h4><a href=\"#\">Thursday practice</a></h4><div class=\"ua-meta\">BP, 2 rooms</div></div><span class=\"ua-tag ua-tag--ok\">Registration</span></div><div class=\"ua-ev\"><span class=\"ua-date\"><b>23</b><span>Oct</span></span><div class=\"ua-ev-body\"><h4><a href=\"#\">Open round</a></h4><div class=\"ua-meta\">BP, open to all</div></div><span class=\"ua-tag ua-tag--info\">Soon</span></div><p class=\"ua-meta\">Club details are kept by the club in cab.</p></div><div><div class=\"ua-sec\">On the map</div><div class=\"ua-card\"><svg class=\"ua-map\" viewBox=\"0 0 640 440\" role=\"img\" aria-label=\"Map of clubs in Ukraine\"><polygon class=\"ua-land\" points=\"11.9,214.2 27.2,178.5 30.6,153.0 61.2,112.2 78.2,86.7 71.4,51.0 88.4,35.7 125.8,34.7 159.8,40.8 204.0,51.0 234.6,58.6 255.0,61.2 285.6,56.1 299.2,66.3 309.4,28.1 340.0,25.5 367.2,15.3 387.6,12.8 418.2,45.9 428.4,68.9 452.2,71.4 462.4,102.0 489.6,112.2 533.8,114.8 550.8,135.1 591.6,142.8 622.2,153.0 622.2,170.9 608.6,193.8 618.8,221.9 612.0,242.2 578.0,242.2 557.6,280.5 533.8,290.7 503.2,298.4 462.4,316.2 442.0,326.4 448.8,351.9 472.6,367.2 499.8,369.8 462.4,397.8 428.4,413.1 397.8,408.0 363.8,367.2 380.8,341.7 404.6,329.0 377.4,331.5 329.8,311.1 302.6,311.1 268.6,367.2 238.0,369.8 217.6,362.1 241.4,316.2 275.4,316.2 282.2,295.8 265.2,270.3 251.6,239.7 217.6,224.4 193.8,211.6 163.2,221.9 108.8,239.7 74.8,237.1 47.6,229.5 27.2,229.5\"/><a class=\"ua-city on\" href=\"#\"><circle cx=\"296.5\" cy=\"109.6\" r=\"13\"/><text x=\"314.5\" y=\"113.6\">Kyiv 3</text></a></svg></div></div></div></main><footer class=\"ua-foot\"><div class=\"ua-foot-in ua-foot-in--3\"><div><a class=\"wordmark ua-foot-mark\" href=\"#\">UAdebates</a><p>Debate Federation of Ukraine</p><p>A debate community since 2011</p></div><div><b>Site</b><a href=\"#\">News</a><a href=\"#\">Calendar</a><a href=\"#\">Clubs</a><a href=\"#\">About</a></div><div><b>Platform</b><a href=\"#\">Cabinet (cab)</a><a href=\"#\">Privacy policy</a><a href=\"#\">Terms of use</a></div><div><b>Contact</b><a href=\"#\">ngo.dfu@uadebate.com</a><a href=\"#\">support@uadebate.com</a><a href=\"#\">t.me/fdu_ua</a></div></div></footer></div>"
