{
  "id": "cm-event-edit",
  "title": "/manage/events/new (new event)",
  "column": "content-manager",
  "order": 4,
  "path": "GET /manage/events/new",
  "bare": true,
  "blocks": [
    {
      "type": "raw",
      "html": "<div class=\"ua\"><header class=\"ua-top\"><a class=\"ua-brand wordmark\" href=\"#\">UAdebates</a><nav class=\"ua-nav\"><a href=\"#\">Home</a><a href=\"#\">News</a><a class=\"on\" href=\"#\">Calendar</a><a href=\"#\">Clubs</a><a href=\"#\">About</a></nav><div class=\"ua-right\"><span class=\"ua-lang\"><b>EN</b> | <a href=\"#\">UA</a></span><a class=\"ua-btn ua-btn--line ua-btn--sm\" href=\"#\">Cabinet</a></div></header><div class=\"ua-cmbar\"><span class=\"ua-cmrole\">Content manager</span><a href=\"#\">Overview</a><a href=\"#\">News</a><a class=\"on\" href=\"#\">Calendar</a><span class=\"ua-cmme\"><span class=\"ua-av\">OK</span>Olena Koval</span><a class=\"ua-cmlink\" href=\"#\">View site</a><a class=\"ua-cmlink\" href=\"#\">Sign out</a></div><main class=\"ua-main\"><div class=\"ua-cmd\"><div class=\"cr\"><a href=\"#\">Calendar</a> / New event</div><div class=\"seg\"><a class=\"qt\" href=\"#\">Cancel</a><a class=\"go\" href=\"#\">Save</a></div></div><div class=\"form ua-card\"><div class=\"f-head\"><h3>New event</h3><p>Shows in the calendar once saved</p></div><div class=\"f-block\"><label class=\"q\">Name <span class=\"req\">*</span></label><input type=\"text\" value=\"Closed adjudicator selection for the Championship\"></div><div class=\"f-block\"><div class=\"half\"><div><label class=\"q\">Kind</label><select><option>Selection</option><option>Tournament</option><option>Training</option><option>Club event</option><option>Meeting</option></select></div><div><label class=\"q\">Format</label><select><option>Not set</option><option>BP</option><option>APF</option></select></div></div></div><div class=\"f-block\"><div class=\"half\"><div><label class=\"q\">Starts <span class=\"req\">*</span></label><input type=\"text\" value=\"29 November 2026, 11:00\"></div><div><label class=\"q\">Ends</label><input type=\"text\" value=\"29 November 2026, 15:00\"></div></div></div><div class=\"f-block\"><label class=\"q\">Place</label><input type=\"text\" value=\"Online\"><div class=\"hint\">City and address, or Online</div></div><div class=\"f-block\"><label class=\"q\">Organiser</label><select><option>Debate Federation of Ukraine</option><option>Kyiv Debate Club</option></select></div><div class=\"f-block\"><label class=\"q\">Registration link</label><input type=\"text\" placeholder=\"https://\"></div><div class=\"f-block\"><label class=\"q\">Description</label><textarea rows=\"3\">Adjudicator selection for the Ukrainian Debate Championship 2026, by invitation of the adjudication committee.</textarea></div><div class=\"f-block\"><label class=\"q\">Visibility <span class=\"req\">*</span></label><div class=\"opts\"><label><input type=\"radio\" name=\"vis\"> Public: everyone sees it, in iCal and on the home page</label><label><input type=\"radio\" name=\"vis\" checked> Private: only content managers see it</label></div></div></div></main><footer class=\"ua-foot\"><div class=\"ua-foot-in ua-foot-in--3\"><div><a class=\"wordmark ua-foot-mark\" href=\"#\">UAdebates</a><p>Debate Federation of Ukraine</p><p>A debate community since 2011</p></div><div><b>Site</b><a href=\"#\">News</a><a href=\"#\">Calendar</a><a href=\"#\">Clubs</a><a href=\"#\">About</a></div><div><b>Platform</b><a href=\"#\">Cabinet (cab)</a><a href=\"#\">Privacy policy</a><a href=\"#\">Terms of use</a></div><div><b>Contact</b><a href=\"#\">ngo.dfu@uadebate.com</a><a href=\"#\">support@uadebate.com</a><a href=\"#\">t.me/fdu_ua</a></div></div></footer></div>"
    },
    {
      "type": "note",
      "text": "Visibility can be switched later from the calendar without opening the form."
    }
  ]
}
