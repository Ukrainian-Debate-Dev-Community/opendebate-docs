      "html": "<div class=\"ua\"><header class=\"ua-top\"><a class=\"ua-brand wordmark\" href=\"#\">UAdebates</a><nav class=\"ua-nav\"><a href=\"#\">Головна</a><a href=\"#\">Новини</a><a href=\"#\">Турніри</a><a href=\"#\">Календар</a><a class=\"on\" href=\"#\">Клуби</a><a href=\"#\">Рейтинги</a><a href=\"#\">Про ФДУ</a></nav><div class=\"ua-right\"><a class=\"ua-edit\" href=\"#\">Редагування</a><span class=\"ua-who\"><span class=\"ua-av\">ОК</span>Олена Коваль</span></div></header><div class=\"ua-cmbar\"><span class=\"ua-cmrole\">Контент-менеджер</span><a href=\"#\">Огляд</a><a href=\"#\">Новини</a><a href=\"#\">Календар</a><a class=\"on\" href=\"#\">Клуби</a><span class=\"ua-cmnote\">Сайт uadebate.com, без доступу до адміністрування кабінету</span></div><main class=\"ua-main\"><div class=\"ua-cmd\"><div class=\"cr\"><a href=\"#\">Клуби</a> / Київський дебатний клуб</div><div class=\"seg\"><a class=\"qt\" href=\"#\">Зняти з публікації</a><a class=\"\" href=\"#\">Скасувати</a><a class=\"go\" href=\"#\">Зберегти</a></div></div><div class=\"form ua-card\"><div class=\"f-head\"><h3>Запис клубу</h3><p>Опубліковано, змінено 3 жовтня 2026</p></div><div class=\"f-block\"><label class=\"q\">Клуб у кабінеті</label><select><option>Київський дебатний клуб (/c/kyiv-debate-club)</option><option>Немає</option></select><div class=\"hint\">Назва береться з кабінету; змінити її може голова клубу</div></div><div class=\"f-block\"><div class=\"half\"><div><label class=\"q\">Місто <span class=\"req\">*</span></label><input type=\"text\" value=\"Київ\"></div><div><label class=\"q\">Область</label><select><option>Київ</option></select></div></div></div><div class=\"f-block\"><label class=\"q\">Формати</label><div class=\"opts ua-opts-row\"><label><input type=\"checkbox\" checked> БПФ</label><label><input type=\"checkbox\"> АПФ</label></div></div><div class=\"f-block\"><label class=\"q\">Мови</label><div class=\"opts ua-opts-row\"><label><input type=\"checkbox\" checked> українська</label><label><input type=\"checkbox\" checked> англійська</label></div></div><div class=\"f-block\"><label class=\"q\">Для кого</label><div class=\"opts ua-opts-row\"><label><input type=\"checkbox\"> школярі</label><label><input type=\"checkbox\" checked> студенти</label><label><input type=\"checkbox\"> дорослі</label></div></div><div class=\"f-block\"><div class=\"half\"><div><label class=\"q\">Зустрічі</label><input type=\"text\" value=\"четвер 18:30\"></div><div><label class=\"q\">Адреса</label><input type=\"text\" value=\"вул. Грушевського, 4, Київ\"></div></div></div><div class=\"f-block\"><label class=\"q\">Контакти</label><input type=\"text\" value=\"t.me/kyivdc\"></div><div class=\"f-block\"><label class=\"q\">Опис</label><textarea rows=\"2\">Щотижнева практика британського парламентського формату для студентів і випускників.</textarea></div><div class=\"f-block\"><label class=\"q\">Точка на мапі</label><div class=\"ua-mini\"><svg class=\"ua-map\" viewBox=\"0 0 640 440\" role=\"img\" aria-label=\"Мапа клубів України\"><polygon class=\"ua-land\" points=\"11.9,214.2 27.2,178.5 30.6,153.0 61.2,112.2 78.2,86.7 71.4,51.0 88.4,35.7 125.8,34.7 159.8,40.8 204.0,51.0 234.6,58.6 255.0,61.2 285.6,56.1 299.2,66.3 309.4,28.1 340.0,25.5 367.2,15.3 387.6,12.8 418.2,45.9 428.4,68.9 452.2,71.4 462.4,102.0 489.6,112.2 533.8,114.8 550.8,135.1 591.6,142.8 622.2,153.0 622.2,170.9 608.6,193.8 618.8,221.9 612.0,242.2 578.0,242.2 557.6,280.5 533.8,290.7 503.2,298.4 462.4,316.2 442.0,326.4 448.8,351.9 472.6,367.2 499.8,369.8 462.4,397.8 428.4,413.1 397.8,408.0 363.8,367.2 380.8,341.7 404.6,329.0 377.4,331.5 329.8,311.1 302.6,311.1 268.6,367.2 238.0,369.8 217.6,362.1 241.4,316.2 275.4,316.2 282.2,295.8 265.2,270.3 251.6,239.7 217.6,224.4 193.8,211.6 163.2,221.9 108.8,239.7 74.8,237.1 47.6,229.5 27.2,229.5\"/><a class=\"ua-city on\" href=\"#\"><circle cx=\"296.5\" cy=\"109.6\" r=\"13\"/></a></svg><span class=\"ua-meta\">50.45, 30.52. Натисни на мапі, щоб перенести</span></div></div></div></main><footer class=\"ua-foot\"><div class=\"ua-foot-in\"><div><a class=\"wordmark ua-foot-mark\" href=\"#\">UAdebates</a><p>Федерація дебатів України</p><p>Дебатна спільнота з 2011 року</p></div><div><b>Сайт</b><a href=\"#\">Новини</a><a href=\"#\">Календар</a><a href=\"#\">Клуби</a><a href=\"#\">Рейтинги</a></div><div><b>Платформа</b><a href=\"#\">Кабінет (cab)</a><a href=\"#\">Базові правила</a><a href=\"#\">База резолюцій</a><a href=\"#\">Реєстр суддів</a></div><div><b>Документи</b><a href=\"#\">Політика конфіденційності</a><a href=\"#\">Умови користування</a><a href=\"#\">Статут ФДУ</a></div><div><b>Контакти</b><a href=\"#\">t.me/fdu_ua</a><a href=\"#\">info@uadebate.com</a></div></div></footer></div>"
