{
  "id": "phoenix-api",
  "kind": "swagger",
  "column": "phoenix-api",
  "order": 1,
  "groups": [
    {
      "title": "clubs & membership",
      "rows": [
        {
          "id": "api-club-get",
          "t": "GET /clubs/:uuid",
          "method": "GET",
          "path": "/clubs/:uuid",
          "desc": "public — club profile + archive from cab's records"
        },
        {
          "id": "api-club-patch",
          "t": "PATCH /clubs/:uuid",
          "method": "PATCH",
          "path": "/clubs/:uuid",
          "desc": "head — profile fields + is_private"
        },
        {
          "id": "api-members",
          "t": "GET /clubs/:uuid/members",
          "method": "GET",
          "path": "/clubs/:uuid/members",
          "desc": "member — roster"
        },
        {
          "id": "api-member-del",
          "t": "DEL /clubs/:uuid/members/:user_id",
          "method": "DEL",
          "path": "/clubs/:uuid/members/:user_id",
          "desc": "head — remove a member"
        },
        {
          "id": "api-join-create",
          "t": "POST /clubs/:uuid/join-requests",
          "method": "POST",
          "path": "/clubs/:uuid/join-requests",
          "desc": "signed in — {message, contact}"
        },
        {
          "id": "api-join-patch",
          "t": "PATCH /join-requests/:id",
          "method": "PATCH",
          "path": "/join-requests/:id",
          "desc": "head — approve | decline"
        }
      ]
    },
    {
      "title": "sessions — lifecycle",
      "rows": [
        {
          "id": "api-sess-create",
          "t": "POST /clubs/:uuid/sessions",
          "method": "POST",
          "path": "/clubs/:uuid/sessions",
          "desc": "head — open a session",
          "api": "POST events · rounds"
        },
        {
          "id": "api-sess-get",
          "t": "GET /sessions/:uuid",
          "method": "GET",
          "path": "/sessions/:uuid",
          "desc": "public — engine state (4 reads, fanned out)"
        },
        {
          "id": "api-sess-del",
          "t": "DEL /sessions/:uuid",
          "method": "DEL",
          "path": "/sessions/:uuid",
          "desc": "head — cancel",
          "api": "DEL events/:id"
        },
        {
          "id": "api-sess-start",
          "t": "POST /sessions/:uuid/start",
          "method": "POST",
          "path": "/sessions/:uuid/start",
          "desc": "head — {rooms} required (422 otherwise); closes sign-ups",
          "api": "POST rounds/:id/rooms"
        },
        {
          "id": "api-close",
          "t": "POST /sessions/:uuid/close-signups",
          "method": "POST",
          "path": "/sessions/:uuid/close-signups",
          "desc": "head"
        },
        {
          "id": "api-reopen-signups",
          "t": "POST /sessions/:uuid/reopen-signups",
          "method": "POST",
          "path": "/sessions/:uuid/reopen-signups",
          "desc": "head"
        },
        {
          "id": "api-reopen-reg",
          "t": "POST /sessions/:uuid/reopen-registration",
          "method": "POST",
          "path": "/sessions/:uuid/reopen-registration",
          "desc": "head — only while no ballot is in"
        },
        {
          "id": "api-finish",
          "t": "POST /sessions/:uuid/finish",
          "method": "POST",
          "path": "/sessions/:uuid/finish",
          "desc": "head — records finished_at + winner",
          "api": "PUT events/:id"
        }
      ]
    },
    {
      "title": "signups, rooms & play",
      "rows": [
        {
          "id": "api-signup",
          "t": "POST /sessions/:uuid/signups",
          "method": "POST",
          "path": "/sessions/:uuid/signups",
          "desc": "signed in or head",
          "api": "POST events/:id/participants"
        },
        {
          "id": "api-signup-del",
          "t": "DEL /sessions/:uuid/signups/:participant_id",
          "method": "DEL",
          "path": "/sessions/:uuid/signups/:participant_id",
          "desc": "self or head",
          "api": "DEL participants/:pid"
        },
        {
          "id": "api-rooms",
          "t": "POST /sessions/:uuid/rooms",
          "method": "POST",
          "path": "/sessions/:uuid/rooms",
          "desc": "head — {rooms} required; no server-side pairing",
          "api": "POST rounds/:id/rooms"
        },
        {
          "id": "api-rooms-del",
          "t": "DEL /sessions/:uuid/rooms",
          "method": "DEL",
          "path": "/sessions/:uuid/rooms",
          "desc": "head — only while no ballot is in",
          "api": "DEL rooms/:id"
        },
        {
          "id": "api-motion",
          "t": "POST /rooms/:id/motion",
          "method": "POST",
          "path": "/rooms/:id/motion",
          "desc": "chair or head",
          "api": "POST rooms/:id/motion"
        },
        {
          "id": "api-ballot",
          "t": "POST /rooms/:id/ballot",
          "method": "POST",
          "path": "/rooms/:id/ballot",
          "desc": "chair or head; confirmed → head only (edit ballot)",
          "api": "POST rooms/:id/scores"
        }
      ]
    },
    {
      "title": "guest links",
      "rows": [
        {
          "id": "api-links",
          "t": "GET /sessions/:uuid/links",
          "method": "GET",
          "path": "/sessions/:uuid/links",
          "desc": "head"
        },
        {
          "id": "api-link-create",
          "t": "POST /sessions/:uuid/links",
          "method": "POST",
          "path": "/sessions/:uuid/links",
          "desc": "head — {name, as}"
        },
        {
          "id": "api-link-del",
          "t": "DEL /links/:id",
          "method": "DEL",
          "path": "/links/:id",
          "desc": "head — revoke"
        }
      ]
    }
  ]
}
