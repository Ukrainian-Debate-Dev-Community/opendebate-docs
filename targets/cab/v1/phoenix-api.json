{
  "id": "phoenix-api",
  "column": "phoenix-api",
  "kind": "swagger",
  "order": 10,
  "groups": [
    {
      "title": "clubs & membership",
      "rows": [
        {
          "id": "api-club-get",
          "t": "GET /clubs/:uuid",
          "method": "GET",
          "path": "/clubs/:uuid",
          "m8b": false,
          "desc": "public → {name, city, university, head, schedule, contacts, head_message, sessions:[{no, name, date, rooms, status done|live|open}]}",
          "api": "GET organisations/:id events + rooms"
        },
        {
          "id": "api-club-patch",
          "t": "PATCH /clubs/:uuid",
          "method": "PATCH",
          "path": "/clubs/:uuid",
          "m8b": false,
          "desc": "head — profile incl. university + head_message (gateway)"
        },
        {
          "id": "api-join-post",
          "t": "POST join-requests",
          "method": "POST",
          "path": "/clubs/:uuid/join-requests",
          "m8b": false,
          "desc": "signed-in — {message, contact} required → 201 pending"
        },
        {
          "id": "api-join-patch",
          "t": "PATCH /join-requests/:id",
          "method": "PATCH",
          "m8b": false,
          "path": "/join-requests/:id {action} · <span class=\"m del\" style=\"width:auto\">DEL</span> /clubs/:uuid/members/:uid",
          "desc": "head — approve | decline · revoke"
        }
      ]
    },
    {
      "title": "sessions — lifecycle",
      "rows": [
        {
          "id": "api-sess-post",
          "t": "POST sessions",
          "method": "POST",
          "path": "/clubs/:uuid/sessions",
          "m8b": false,
          "desc": "head — {name, scheduled_at?} → 201 {uuid, stage:\"signup\"}",
          "api": "POST events + rounds"
        },
        {
          "id": "api-sess-get",
          "t": "GET /sessions/:uuid",
          "method": "GET",
          "path": "/sessions/:uuid",
          "m8b": false,
          "desc": "public → session + signups + rooms + winner; no stage tags in UI",
          "api": "GET event + rounds + rooms + participants"
        },
        {
          "id": "api-close-signups",
          "t": "POST close-signups",
          "method": "POST",
          "path": "/sessions/:uuid/close-signups",
          "m8b": false,
          "desc": "head — closes public sign-ups; the session page becomes the allocation surface"
        },
        {
          "id": "api-reopen-signups",
          "t": "POST reopen-signups",
          "method": "POST",
          "path": "/sessions/:uuid/reopen-signups",
          "m8b": false,
          "desc": "head — deletes pending rooms, reopens public sign-ups",
          "api": "DELETE rooms/:id each"
        },
        {
          "id": "api-signup",
          "t": "POST signups",
          "method": "POST",
          "m8b": false,
          "path": "/sessions/:uuid/signups · <span class=\"m del\" style=\"width:auto\">DEL</span> /:pid",
          "desc": "self {as} · head +{username} anytime; public only while registration open",
          "api": "POST/DELETE participants"
        },
        {
          "id": "api-finish",
          "t": "POST finish",
          "method": "POST",
          "path": "/sessions/:uuid/finish",
          "m8b": false,
          "desc": "head → completed; winner from confirmed ballots. (DELETE /sessions stays API-only — no cancel in UI)",
          "api": "PUT rounds + event completed"
        }
      ]
    },
    {
      "title": "rooms & play",
      "rows": [
        {
          "id": "api-rooms",
          "t": "rooms create/delete",
          "method": "POST",
          "m8b": false,
          "path": "/sessions/:uuid/rooms · <span class=\"m del\" style=\"width:auto\">DEL</span> /rooms/:id",
          "desc": "head — create rooms from the compose table; delete pending rooms",
          "api": "POST rounds/:id/rooms · DELETE rooms/:id"
        },
        {
          "id": "api-motion",
          "t": "motion draft/release",
          "method": "POST",
          "m8b": true,
          "path": "/rooms/:id/motion-draft · /rooms/:id/release-motion <span class=\"m8b\">M8b</span>",
          "desc": "room judge — motion text (hidden draft, gateway); RELEASE → engine motion + released_at; prep = +15:00",
          "api": "POST rooms/:id/motion (on release)"
        },
        {
          "id": "api-ballot",
          "t": "POST ballot",
          "method": "POST",
          "m8b": false,
          "path": "/rooms/:id/ballot · <span class=\"m patch\" style=\"width:auto\">PATCH</span> /rooms/:id/reopen",
          "desc": "room judge — 8 scores 50-100/0.5, tied totals 422; reopen own room while live",
          "api": "POST scores + PATCH confirm · unconfirm+reopen"
        }
      ]
    },
    {
      "title": "registration & links",
      "rows": [
        {
          "id": "api-reg",
          "t": "/r/:sess registration",
          "method": "POST",
          "path": "/r/:sess (html)",
          "m8b": false,
          "desc": "anonymous — {name, as} → personal /l/:code shown",
          "api": "POST users (shadow) + participants"
        },
        {
          "id": "api-links",
          "t": "links",
          "method": "GET",
          "m8b": false,
          "path": "/sessions/:uuid/links · <span class=\"m post\" style=\"width:auto\">POST</span> {name, as} · <span class=\"m del\" style=\"width:auto\">DEL</span> /links/:id",
          "desc": "head — list, issue by hand, revoke (URL dies, signup stays)"
        }
      ]
    },
    {
      "title": "stats (pages; keyed api later)",
      "rows": [
        {
          "id": "api-standings",
          "t": "standings pages",
          "method": "GET",
          "m8b": false,
          "path": "/standings/:tab · /c/:club/standings/:tab",
          "desc": "rule 0: engine output verbatim per session — calculated teams/speakers; judges + clubs = plain counts; no cab-side math",
          "api": "GET events/:id/standings/calculated/{teams|speakers}"
        }
      ]
    }
  ]
}
